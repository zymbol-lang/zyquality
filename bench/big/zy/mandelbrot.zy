w = 250
h = 250
maxit = 100
inside = 0
@ py:0..(h - 1) {
    @ px:0..(w - 1) {
        cr = (3.0 * px) / w - 2.0
        ci = (2.0 * py) / h - 1.0
        zr = 0.0
        zi = 0.0
        it = 0
        @ it < maxit {
            t = zr * zr - zi * zi + cr
            zi = 2.0 * zr * zi + ci
            zr = t
            ? zr * zr + zi * zi > 4.0 { @! }
            it = it + 1
        }
        ? it == maxit { inside = inside + 1 }
    }
}
>> "mandelbrot inside=" inside ¶
