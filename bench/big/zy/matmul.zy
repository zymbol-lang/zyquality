n = 150
a = []
b = []
@ i:0..(n - 1) {
    @ j:0..(n - 1) {
        a = a $+ ((i * j) % 10)
        b = b $+ ((i + j) % 7)
    }
}
chk = 0
@ i:0..(n - 1) {
    @ j:0..(n - 1) {
        s = 0
        @ k:0..(n - 1) {
            s = s + a[i * n + k + 1] * b[k * n + j + 1]
        }
        chk = (chk + s * (i + j + 1)) % 1000003
    }
}
>> "matmul chk = " chk ¶
