# lib_time {
    <# std/time => clock

    // Timing utilities for Zymbol-Lang benchmarks.
    // Reads the clock with `std/time`'s `now()`: native in the three engines,
    // milliseconds since the epoch, and no process per reading.
    //
    // Until 2026-10-09 it read `<\ "date +%s%6N" \>` — `std/time` did not exist
    // when this was written — and every reading spawned a process: an empty
    // block measured 2–4 ms, so every benchmark line carried that floor, and a
    // test that does 1 ms of work could not be told from one that does none
    // (zyquality/notes/VM_VS_PYTHON.md). `bench/baseline.txt` was recorded again
    // the same day.
    //
    // Usage:
    //   <# ./lib_time => T
    //   t0 = T::now()
    //   // ... work ...
    //   >> T::elapsed(t0) ¶          // "(0.235s)"
    //   >> T::total(t0) ¶            // "0.235s total"

    #> { now, elapsed, total }

    // Return current time in milliseconds since the epoch.
    now() {
        <~ clock::now()
    }

    // Format elapsed time since start_ms as "(X.XXXs)".
    elapsed(start_ms) {
        diff = clock::now() - start_ms
        s    = diff / 1000
        ms   = diff - (s * 1000)
        ? ms < 10 {
            <~ "(" s ".00" ms "s)"
        }
        _? ms < 100 {
            <~ "(" s ".0" ms "s)"
        }
        _ {
            <~ "(" s "." ms "s)"
        }
    }

    // Format elapsed time since start_ms as "X.XXXs total".
    total(start_ms) {
        diff = clock::now() - start_ms
        s    = diff / 1000
        ms   = diff - (s * 1000)
        ? ms < 10 {
            <~ s ".00" ms "s total"
        }
        _? ms < 100 {
            <~ s ".0" ms "s total"
        }
        _ {
            <~ s "." ms "s total"
        }
    }
}
