// cost/marco_temporales — una función cuyo cuerpo tiene 64 sentencias que NUNCA
// se ejecutan (`x` no es negativo), cada una con sus temporales y sin ninguna
// variable. Pareja de `marco_minimo.zy.in`, que tiene una sola: el trabajo que se
// ejecuta es el mismo, instrucción por instrucción. La razón entre las dos es lo
// que cuesta, en cada llamada, un marco que mide todos los temporales que la
// función pidió alguna vez y no los que necesita a la vez (ZYVM-010).

paso(x, a, b) {
    ? x < 0 {
        >> ((x + a) * (b + 1) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 2) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 3) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 4) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 5) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 6) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 7) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 8) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 9) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 10) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 11) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 12) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 13) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 14) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 15) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 16) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 17) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 18) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 19) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 20) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 21) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 22) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 23) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 24) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 25) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 26) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 27) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 28) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 29) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 30) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 31) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 32) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 33) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 34) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 35) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 36) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 37) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 38) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 39) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 40) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 41) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 42) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 43) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 44) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 45) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 46) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 47) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 48) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 49) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 50) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 51) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 52) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 53) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 54) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 55) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 56) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 57) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 58) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 59) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 60) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 61) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 62) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 63) - (a * 2 + b)) % 97 ¶
        >> ((x + a) * (b + 64) - (a * 2 + b)) % 97 ¶
    }
    <~ x + a
}

N := «N»
s = 0
@ i:1..N { s = paso(i % 7, s % 3, 2) % 1000 }
>> s ¶
