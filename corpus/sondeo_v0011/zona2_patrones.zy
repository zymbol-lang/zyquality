// The five-zone probe of v0.0.11, zone 2 (?? in all its pattern forms), 2026-10-16.
//
// Every operand that could be evaluated twice, or in another order, is a call
// that prints: the output says how many times and in which order, which a
// golden of values alone cannot. What it found is filed in ZyDDT/HALLAZGOS:
// ZYJS-064, ZYJS-065.

eco(x) {
    >> "<" x ">"
    <~ x
}
>> "1 escrutado:" ¶
r = ?? eco(5) {
    1 => "uno"
    5 => "cinco"
    _ => "otro"
}
>> r ¶
>> "2 comparacion:" ¶
r = ?? 15 {
    < eco(10) => "a"
    < eco(20) => "b"
    < eco(30) => "c"
    _ => "d"
}
>> r ¶
>> "3 alternativas:" ¶
r = ?? 7 {
    == eco(1) || == eco(7) || == eco(9) => "si"
    _ => "no"
}
>> r ¶
>> "4 lista con expr:" ¶
r = ?? 2 {
    [1, 2, 3] => "esta"
    _ => "no"
}
>> r ¶
>> "5 valor del brazo:" ¶
r = ?? 2 {
    1 => eco("uno")
    2 => eco("dos")
    _ => eco("otro")
}
>> r ¶
>> "6 int float:" ¶
>> (?? 1.0 { 1 => "int" _ => "otro" }) " " (?? 1 { 1.0 => "float" _ => "otro" }) ¶
>> "8 negativos:" ¶
>> (?? -5 { -10..-1 => "neg" _ => "otro" }) " " (?? -5 { -5 => "lit" _ => "otro" }) ¶
>> "9 rango invertido:" ¶
>> (?? 5 { 10..1 => "dentro" _ => "fuera" }) ¶
>> "10 bool:" ¶
>> (?? #1 { #0 => "f" #1 => "v" _ => "?" }) ¶
>> "11 ident escalar y arreglo:" ¶
lim = 3
grupo = [4, 5]
>> (?? 3 { lim => "lim" _ => "no" }) " " (?? 5 { grupo => "grupo" _ => "no" }) ¶
>> "12 lista estructural:" ¶
>> (?? #[1, [2, 3]] { [1, [2, _]] => "anidada" _ => "no" }) " " (?? [] { [] => "vacia" _ => "no" }) ¶
>> "13 lista sobre texto:" ¶
>> (?? "ab" { ["ab", "cd"] => "en" _ => "no" }) ¶
>> "14 error:" ¶
falla(k) {
    ? k == 1 { <~ ##Parse("mal") }
    ? k == 2 { <~ ##IO("disco") }
    <~ k
}
@ k:1..3 {
    >> (?? falla(k) {
        ##Parse(m) => ("P:" m)
        ##IO(_) => "IO"
        _ => "valor"
    }) " "
}
>> ¶
>> "15 nombre ya visible:" ¶
m = "antes"
r = ?? falla(1) {
    ##Parse(m) => m
    _ => "no"
}
>> r " " m ¶
>> "16 Depth:" ¶
hondo(n) {
    ? n == 0 { <~ 0 }
    <~ 1 + hondo(n - 1)
}
e = 0
!? { e = hondo(20000) } :! { e = _err }
>> (?? e { ##Depth(t) => "depth" ##Range => "range" _ => "otro" }) ¶
>> "17 sin coincidencia:" ¶
!? { r = ?? 9 { 1 => "a" } } :! { >> _err }
>> ¶
>> "18 control en brazo:" ¶
@ i:1..5 {
    ?? i {
        2 => { @> }
        4 => { @! }
        _ => { >> i }
    }
}
>> ¶
>> "19 retorno en brazo:" ¶
clase(x) {
    ?? x {
        < 0 => { <~ "neg" }
        _ => { <~ "nonneg" }
    }
    <~ "nunca"
}
>> clase(-1) " " clase(1) ¶
>> "20 anidado:" ¶
>> (?? 2 { 2 => (?? 3 { 3 => "dos-tres" _ => "x" }) _ => "y" }) ¶
>> "21 funcion:" ¶
doble(x) { <~ x * 2 }
>> (?? doble { doble => "doble" _ => "otro" }) ¶
>> "24 rango float:" ¶
>> (?? 2.5 { 1..3 => "dentro" _ => "fuera" }) ¶
