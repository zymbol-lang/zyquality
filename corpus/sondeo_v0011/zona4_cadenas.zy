// The five-zone probe of v0.0.11, zone 4 (strings and format), 2026-10-16.
//
// Every operand that could be evaluated twice, or in another order, is a call
// that prints: the output says how many times and in which order, which a
// golden of values alone cannot. What it found is filed in ZyDDT/HALLAZGOS:
// GLB-136, pending.

eco(x) {
    >> "<" x ">"
    <~ x
}
>> "1 interpolacion:" ¶
n = 3
t = "ñ"
>> "a{n}b{t}c{n}" ¶
>> "2 no ascii:" ¶
s = "ñandú🦆é"
>> s$# " " s$[2..4] " " (s$? "dú") " " s$?? 'é' " " (s$/ 'd') ¶
>> "3 vacio:" ¶
v = ""
>> "[" v$# "]" (v$? "") " " (v$/ ',') " [" v$- 'a' "]" ¶
>> "4 reemplazo:" ¶
>> "ñañaña"$~~["ña":"x"] " " "ñañaña"$~~["ña":"x":2] " " "aaa"$~~["a":"aa"] ¶
>> "5 insertar quitar:" ¶
>> "ñandú"$+[3] "--" " " "ñandú"$-[2] " " "ñandú"$-[2..3] " " "ñandú"$-- 'ñ' ¶
>> "6 formato:" ¶
>> #.2|3.14159| " " #.0|2.5| " " #.0|3.5| " " #.3|-0.0005| " " #.2|7| ¶
>> "7 flotantes:" ¶
>> 0.1 + 0.2 " " 1.0 / 3.0 " " 1.0e21 " " 1.0e-7 " " 2.0 " " (-0.0) " " 1.5e300 * 1.0e300 ¶
>> "8 casts:" ¶
>> ##.7 " " ###3.9 " " (###-3.9) " " ##.(7 / 2) ¶
>> "9 hex:" ¶
>> 0x|255| " " 0x|1| " " 0b|5| ¶
>> "10 colecciones:" ¶
>> ([1.0, 2.5]) " " #[1, "a", 'b', #1, [2]] " " (1, (2, 3)) " " #(a: [1, 2], b: #(c: 1.0)) ¶
>> "11 unit en coleccion:" ¶
u = ##_
>> "[" u "]" #[u, 1] ¶
>> "12 caracteres:" ¶
>> ##!'ñ' " " ##'241 " " 'a' 'b' ¶
>> "13 comparacion texto:" ¶
>> ("abc" < "abd") " " ("Z" < "a") " " ("ñ" > "z") " " ("" < "a") ¶
>> "14 $++ con efecto:" ¶
r = eco("x") $++ eco(1) eco("y")
>> " " r ¶
>> "15 $~~ con efecto:" ¶
r = eco("aXa")$~~[eco("a"):eco("b")]
>> " " r ¶
>> "16 numeral:" ¶
#०९#
>> 1234 " " 3.5 " " ([1, 2]) " " #.2|1.5| ¶
#09#
>> 1234 ¶
>> "17 repetir:" ¶
>> "ab" $* 3 " [" "ab" $* 0 "]" ¶
>> "18 escapes:" ¶
>> "a\tb" " " "\\" " " "\"q\"" " \{x\}" ¶
>> "19 dividir multi:" ¶
>> ("a::b::::c" $/ "::") " " ("abc" $/ 'z') ¶
>> "20 interp de expr:" ¶
d = #(k: 1)
a = [5, 6]
>> "{d} {a}" ¶
