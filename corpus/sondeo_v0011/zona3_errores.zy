// The five-zone probe of v0.0.11, zone 3 (error flow), 2026-10-16.
//
// Every operand that could be evaluated twice, or in another order, is a call
// that prints: the output says how many times and in which order, which a
// golden of values alone cannot. What it found is filed in ZyDDT/HALLAZGOS:
// ZYJS-066.

eco(x) {
    >> "<" x ">"
    <~ x
}
>> "1 efectos antes del fallo:" ¶
n = 0
!? {
    n = 1
    x = 1 / 0
    n = 2
} :! { >> "c" } :> { >> "f" }
>> " n=" n ¶
>> "2 finally con retorno:" ¶
r1() {
    !? { <~ eco("t") } :! { <~ "c" } :> { >> "F" }
    <~ "nunca"
}
>> " " r1() ¶
>> "3 finally en bucle:" ¶
@ i:1..3 {
    !? {
        ? i == 2 { @> }
        ? i == 3 { @! }
        >> i
    } :> { >> "F" }
}
>> ¶
>> "4 sin captura con finally:" ¶
!? {
    !? { y = [1][5] } :! ##Div { >> "div" } :> { >> "F1" }
} :! { >> " fuera:" _err }
>> ¶
>> "5 error en la captura:" ¶
!? {
    !? { y = 1 / 0 } :! { z = [1][9] } :> { >> "F2" }
} :! { >> " " _err }
>> ¶
>> "6 error en el finally:" ¶
!? {
    !? { y = 1 / 0 } :! { >> "c" } :> { w = [1][9] }
} :! { >> " " _err }
>> ¶
>> "7 retorno en finally:" ¶
r2() {
    !? { <~ "t" } :> { <~ "f" }
    <~ "nunca"
}
>> r2() ¶
>> "8 tipadas en orden:" ¶
!? { y = 1 / 0 } :! ##Index { >> "idx" } :! ##Div { >> "div" } :! { >> "otro" }
>> ¶
>> "9 _err anidado:" ¶
!? { y = 1 / 0 } :! {
    !? { z = [1][9] } :! { >> _err " | " }
    >> _err
}
>> ¶
>> "10 valor no se lanza:" ¶
mk() { <~ ##Parse("p") }
!? { v = mk() >> v$! } :! { >> "capturado" }
>> ¶
>> "11 propaga valor:" ¶
etapa(k) {
    r = k
    ? k == 0 { r = mk() }
    r$!!
    <~ r * 10
}
>> etapa(2) " " etapa(0) ¶
>> "12 variables tras fallo en funcion:" ¶
a = "fuera"
toca() {
    b = 1
    x = 1 / 0
}
!? { toca() } :! { >> a }
>> ¶
>> "13 error en lambda de map:" ¶
!? { r = [1, 0, 2]$> (x -> 10 / x) >> r } :! { >> _err }
>> ¶
>> "14 captura modifica fuera:" ¶
m = 1
!? { y = 1 / 0 } :! { m = 2 } :> { m = m * 10 }
>> m ¶
>> "15 finally solo:" ¶
!? { >> "t" } :> { >> "F" }
>> ¶
>> "16 tipo nativo:" ¶
!? { y = "a" + 1 } :! ##Type { >> "type" }
>> ¶
>> "17 escrutado con efecto en catch:" ¶
!? { y = [1][eco(9)] } :! ##Index { >> "idx" }
>> ¶
>> "18 cuantas veces finally:" ¶
cuenta() {
    @ i:1..3 {
        !? { ? i == 2 { <~ i } } :> { >> "F" i }
    }
    <~ 0
}
>> " " cuenta() ¶
