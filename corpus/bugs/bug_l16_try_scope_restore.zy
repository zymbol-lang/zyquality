// Regression test for former limitation L16 (REFERENCE.md): when a function
// called inside !? failed at runtime, the caller's scope was corrupted — every
// outer variable became undefined after the !? block (tree-walker), and the
// :! clause did not even fire (VM: the catch only checked the top frame).
// Now: the error is caught in the calling frame and the outer scope survives.

base = 10
saludo = "hola"

// The failure used to be `adder(n) { <~ n + base }` — a function reading a file
// variable, which was `'base' is undefined` while a direct call was isolated.
// That is no longer an error: a named function CAPTURES the file's variables
// (ERROR-ZYB-002, v0.0.9), so this file needed another way to make a function
// fail at run time. A division by zero is one, and it is what the two cases
// below already used.
falla(n) { <~ 10 / n }

!? {
    _x = falla(0)          // fails inside the called frame
} :! {
    >> "caught" ¶
}

// Outer scope must be intact after the caught error
>> base ¶
>> saludo ¶

// Error two frames deep: outer() calls inner(), inner fails at runtime
// (division by zero), the catch in the outermost frame still fires
inner(n) { <~ 10 / n }
outer(n) { <~ inner(n) }

!? {
    _y = outer(0)
} :! {
    >> "caught deep" ¶
}
>> base ¶

// Typed catch across frames: index error raised inside a called function
toma(arr) { <~ arr[99] }
!? {
    _z = toma([1, 2, 3])
} :! ##Index {
    >> "caught index" ¶
}
>> saludo ¶

// Normal calls still work after all the caught failures
suma(a, b) { <~ a + b }
>> suma(base, 5) ¶
