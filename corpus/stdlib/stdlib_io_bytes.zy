// Test: std/io read_bytes / write_bytes — a file's bytes as a text of bytes
// (D-22, decided 2026-11-24). A byte is a Char from 0x00 to 0xFF, the way the
// language already writes one (0x01, ##'n), so a file that is not UTF-8 can be
// read, looked at and written back as it was.
<# std/io => io

tmp = "zy_io_bytes_test.bin"

// "bad " FF FE " utf8": not UTF-8, so io::read refuses it, softly.
bad = "bad " 0xFF 0xFE " utf8"
io::write_bytes(tmp, bad)
r = io::read(tmp)
>> r ¶

// read_bytes gives one Char per byte, and they are the bytes written.
b = io::read_bytes(tmp)
>> b$# " " ##!b[5] " " ##!b[6] " " (b[5] == 0xFF) " " (b == bad) ¶

// The round trip: written back, read again, the same bytes.
io::write_bytes(tmp, b)
>> (io::read_bytes(tmp) == bad) ¶

// Every byte from 0x00 to 0xFF, there and back.
all = ""
@ n:0..255 { all = all ##'n }
io::write_bytes(tmp, all)
back = io::read_bytes(tmp)
>> back$# " " (back == all) " " ##!back[1] " " ##!back[256] ¶

// A UTF-8 file seen as bytes: é is C3 A9, and io::read still reads it as text.
io::write(tmp, "é")
e = io::read_bytes(tmp)
>> e$# " " 0x|e[1]| " " 0x|e[2]| " " io::read(tmp) ¶

// A Char past 0xFF is no byte: ##Range, and the file is left as it was.
!? {
    io::write_bytes(tmp, "aあ")
} :! ##Range {
    >> "##Range" ¶
}
>> io::read(tmp) ¶

io::delete(tmp)
>> io::exists(tmp) ¶
