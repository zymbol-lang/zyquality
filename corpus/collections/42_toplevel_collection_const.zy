// A top-level collection constant is visible inside a function, like any other
// `:=` constant.
//
// The VM inlined a module-or-program constant at each use site by emitting one
// `Load*` instruction, and there is no single instruction that loads an array —
// so `eval_const_expr` returned nothing for a collection and the name fell
// through to "undefined variable", but only under the VM and only inside a
// function. The tree-walker had always resolved it.
//
// Collections are not inlined now: they become globals, materialized once when
// the VM starts, so a table is built once however many times it is read.

LADOS := [10, 20, 30]
TABLA := (es: "hola", en: "hi")
PAR   := (1, 2)

lado(i) { <~ LADOS[i] }
saludo(k) { <~ TABLA[k] }
segundo() { <~ PAR[2] }

>> lado(1) ¶
>> lado(3) ¶
>> saludo("en") ¶
>> segundo() ¶

// Read in a loop: the value is the same every time round.
@ _v:1..3 {
    >> saludo("es") ¶
}
