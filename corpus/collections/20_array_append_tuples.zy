// Test: $+ append of tuples and named tuples into arrays
// Covers: direct literals, variables, mixed, and field access after append.

// ── Positional tuples — literal ───────────────────────────────────────────────
arr = []
arr = arr$+ (1, 2, 3)
arr = arr$+ (4, 5, 6)
>> arr$# ¶
>> arr[1][1] ¶
>> arr[2][3] ¶

// ── Positional tuples — from variable ─────────────────────────────────────────
t1 = (10, 20)
t2 = (30, 40)
pts = []
pts = pts$+ t1
pts = pts$+ t2
>> pts$# ¶
>> pts[1][1] ¶
>> pts[1][2] ¶
>> pts[2][1] ¶

// ── Named tuples — literal ────────────────────────────────────────────────────
db = []
db = db$+ #(id: 1, name: "Ana",   age: 25, mail: "ana@corp.com")
db = db$+ #(id: 2, name: "Bob",   age: 30, mail: "bob@corp.com")
db = db$+ #(id: 3, name: "Carla", age: 28, mail: "carla@corp.com")
>> db$# ¶
>> db[1].name ¶
>> db[2].age ¶
>> db[3].mail ¶

// ── Named tuples — from variable ──────────────────────────────────────────────
r1 = #(id: 4, name: "Dan",  age: 35, mail: "dan@corp.com")
r2 = #(id: 5, name: "Eva",  age: 22, mail: "eva@corp.com")
db = db$+ r1
db = db$+ r2
>> db$# ¶
>> db[4].name ¶
>> db[5].name ¶
>> db[5].id ¶

// ── Mixed: positional and named in same array ─────────────────────────────────
mixed = []
mixed = mixed$+ (0, 0)
mixed = mixed$+ #(name: "origin", x: 0, y: 0)
>> mixed$# ¶
>> mixed[1][1] ¶
>> mixed[2].name ¶

// ── Build table in loop then query ────────────────────────────────────────────
table = []
@ i:0..4 {
    table = table$+ #(id: i, val: i * 10)
}
>> table$# ¶
>> table[1].id ¶
>> table[1].val ¶
>> table[4].id ¶
>> table[4].val ¶

// ── Append and immediately slice ──────────────────────────────────────────────
base = [#(id: 1, name: "A"), #(id: 2, name: "B")]
extra = #(id: 3, name: "C")
full = base$+ extra
page = full$[2:2]
>> page$# ¶
>> page[1].name ¶
>> page[2].name ¶
