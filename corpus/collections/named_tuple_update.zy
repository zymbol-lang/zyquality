// Test: $~ funcional update sobre named tuples (G2)

// Update por clave — el acceso posicional se retiró (decisión 11)
p = #(x: 1, y: 2, z: 3)
p2 = p["y"]$~ 99
>> p2.x ¶
>> p2.y ¶
>> p2.z ¶

// Update por nombre de campo (string)
p3 = p["z"]$~ 42
>> p3.x ¶
>> p3.y ¶
>> p3.z ¶

// El original no se modifica
>> p.x ¶
>> p.y ¶
>> p.z ¶

// Última clave, por su nombre
p4 = p["z"]$~ 77
>> p4.z ¶

// Update encadenado (simula deep update en named tuple anidado)
a = #(val: 10, meta: #(ok: #1, code: 0))
a2 = a["meta"]$~ (a.meta["code"]$~ 200)
>> a2.meta.code ¶
>> a2.meta.ok ¶
