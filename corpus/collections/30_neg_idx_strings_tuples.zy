// Test: negative indices on strings, tuples, and named tuples
// Complements 26_negative_indices.zy which focused on plain arrays.

// ── String — various negative positions ─────────────────────────────────────
s = "abcdefg"
>> s[-1] ¶        // → g  (last char)
>> s[-2] ¶        // → f
>> s[-7] ¶        // → a  (first, via -length)

// Single-char string
one = "Z"
>> one[-1] ¶      // → Z

// ── String — remove at negative index ───────────────────────────────────────
s2 = s$-[-1]      // removes 'g' → "abcdef"
>> s2$# ¶         // → 6
>> s2[-1] ¶       // → f

s3 = s$-[-3]      // removes 'e' → "abcdfg"
>> s3$# ¶         // → 6
>> s3[5] ¶        // → f  (1-based position 5, 'g' still at end)

// ── Positional tuple — negative access ──────────────────────────────────────
t = (10, 20, 30, 40, 50)
>> t[-1] ¶        // → 50
>> t[-2] ¶        // → 40
>> t[-5] ¶        // → 10

// ── Positional tuple — remove at negative index ──────────────────────────────
t2 = t$-[-1]      // removes last → (10, 20, 30, 40)
>> t2$# ¶         // → 4
>> t2[-1] ¶       // → 40

t3 = t$-[-2]      // removes second-to-last (40) → (10, 20, 30, 50)
>> t3[-1] ¶       // → 50
>> t3[-2] ¶       // → 30

// ── Dictionary — by key; positional access was withdrawn (decision 11) ──────
person = (id: 1, name: "Ana", age: 25, city: "Lima")
>> person["city"] ¶   // → Lima
>> person["age"] ¶    // → 25
>> person["id"] ¶     // → 1

// ── Dictionary — remove by KEY; the whole positional family was withdrawn ───
// `person$-[-1]` used to trim the last key by position. Decision 11 took the
// family with it: a position is not a stable address in a mutable dictionary.
p2 = person$-["city"]
>> p2$# ¶          // → 3
>> p2["age"] ¶     // → 25
