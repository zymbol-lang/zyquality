// Test: the bare bars |n| turn an Int code point into its Char (D-25,
// v0.0.12) — the pair of 06_char_to_int. It was `##'n` from v0.0.10 to
// v0.0.11 (GLB-109), and `0d|n|` for a day of v0.0.12 (D-24).

>> |65| ¶           // A
>> |122| ¶          // z
>> |12354| ¶        // あ  (hiragana A)

// Result type is Char
c = |66|
meta = c#?
>> meta[1] ¶          // ##'

// A computed code, which no literal can spell: shift each letter by 3
shifted = ""
@ ch:"abc" {
    shifted = shifted |#|ch| + 3|
}
>> shifted ¶          // def

// Round trip at the edges of Unicode
@ code:[0, 55295, 57344, 1114111] {
    back = |code|
    >> (#|back| == code) ¶
}

// A code with no character is ##Range: past 0x10FFFF, a surrogate, below 0
@ code:[1114112, 55296, -1] {
    !? {
        >> |code| ¶
    } :! ##Range {
        >> "range" ¶
    }
}

// Only an Int is a code: a Float, even a whole one, is ##Type
!? {
    >> |65.0| ¶
} :! ##Type {
    >> "type" ¶
}

// The bases write the code as text, and the bare bars read any of them back
>> 0x|65| " " 0d|65| " " |"0x41"| " " |"0b01000001"| " " |"0o101"| " " |"65"| ¶   // 0x41 0d65 A A A A
