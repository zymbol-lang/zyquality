// Test: writing a text position by position, and what must not change (ZYJS-076)
// A write where the text is may happen only for the variable that owns it:
// another name, an argument, a capture and a copy keep what they had.
b = 0x61 $* 200
a = b
b[1]$~ 'X'
b[200]$~ 'Y'
>> a$[1..3] " " a$[198..200] " " b$[1..3] " " b$[198..200] ¶
c = b[2]$~ 'Z'
>> b$[1..3] " " c$[1..3] ¶
f(t) {
    t[3]$~ 'Q'
    <~ t$[1..4]
}
>> f(b) " " b$[1..4] ¶
g = () -> b$[1..2]
b[1]$~ 'W'
>> g() " " b$[1..2] ¶

// Read whole after writes: output, join, compare, search, slice, count
@ i:1..200 { b[i]$~ 'k' }
>> (b == ('k' $* 200)) " " b$# " " (b$? 'a') " " (b$?? 'k')$# ¶
s = b "!"
>> s$# " " s$[199..201] " " "{b}"$# ¶

// Characters of two UTF-16 units, and writes that change the width
e = '😀' $* 100
e[50]$~ '🙃'
e[51]$~ 'a'
e[52]$~ "xyz"
>> e$# " " e$[49..53] " " #|e[50]| " " #|e[100]| ¶
m = 0x80 $* 100
m[10]$~ '😀'
m[11]$~ 0xFF
>> m$# " " #|m[10]| " " #|m[11]| " " #|m[12]| ¶

// In a collection, and through a deep path
l = [0x61 $* 80, 0x62 $* 80]
l[2>5]$~ 'Q'
>> l[2]$[4..6] " " l[1]$[4..6] ¶
d = #(k: 0x63 $* 90)
d["k"]$~ (d.k[1]$~ 'R')
>> d.k$[1..2] ¶

// A loop that reads and writes the same text
r = 0x30 $* 300
@ i:2..300 { r[i]$~ |(#|r[i - 1]| % 10 + 49)| }
>> r$[1..12] " " r$[290..300] ¶
