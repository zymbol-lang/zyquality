// claim: >> "a=" a " b=" b ¶          // juxtaposition; postfix needs no parens, on a name or a literal:
// claim: >> "eq=" (a == b) ¶          // parenthesised expressions are single items
a = 1
b = 2
arr = [7, 8]
>> "a=" a " b=" b ¶           // → a=1 b=2
>> "len=" arr$# ¶             // → len=2
>> [1,2]#? ¶                  // → (##], 2, [1, 2])
>> 42#?[1] ¶                  // → ###
>> "eq=" (a == b) ¶           // → eq=#0
