// claim: nums$< (0, (acc,x) -> acc+x) // reduce (initial, lambda)
// claim: 5 |> double |> inc           // pipe; explicit slot when not first: 10 |> add(_, 5)
// claim: `$>`/`$|`/`$<` chain directly: `nums$| (x -> x > 2)$> (x -> x * 10)$< (0, (a,x) -> a+x)`.
double(x) { <~ x * 2 }
inc(x) { <~ x + 1 }
add(a, b) { <~ a + b }
nums = [1, 2, 3, 4]
>> (nums$> (x -> x * 2)) ¶            // → [2, 4, 6, 8]
>> (nums$| (x -> x % 2 == 0)) ¶       // → [2, 4]
>> (nums$< (0, (acc, x) -> acc + x)) ¶    // → 10
>> (5 |> double |> inc) ¶             // → 11
>> (10 |> add(_, 5)) ¶                // → 15
>> (nums$| (x -> x > 2)$> (x -> x * 10)$< (0, (a, x) -> a + x)) ¶    // → 70
